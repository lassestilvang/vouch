# Required: Nebius Token Factory key (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=

# Recommended: Tavily key (https://tavily.com). Without one, Vouch uses Tavily's
# rate-limited keyless mode.
TAVILY_API_KEY=

# Optional: raises the GitHub API limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Optional: pin model ids. By default Vouch reads /v1/models and picks the
# Nemotron 3 Nano / Super / Ultra models that Token Factory serves.
# VOUCH_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# VOUCH_MODEL_SUPER=nvidia/Nemotron-3-Super-120B-A12B
# VOUCH_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional: checks per IP per 10 minutes (default 20).
# VOUCH_RATE_LIMIT=20
